{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ticketbrain.app" }],
      "destination": "/index.en.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ticketbrain.es" }],
      "destination": "/index.es.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ticketbrain.app" }],
      "destination": "/index.en.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ticketbrain.es" }],
      "destination": "/index.es.html"
    }
  ]
}