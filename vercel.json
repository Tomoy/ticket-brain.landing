{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "ticketbrain.app" }
      ],
      "destination": "/index.en.html"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "ticketbrain.es" }
      ],
      "destination": "/index.es.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}